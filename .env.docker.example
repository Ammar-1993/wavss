# ==========================================
# Application Configuration (Template)
# ==========================================
# The PHP application reads these exact keys
DB_HOST=db
DB_NAME=wavssv3_db
DB_USER=root
DB_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# ==========================================
# Database Initialization (MariaDB)
# ==========================================
# The MariaDB container reads these to set up
# the database on first boot.
MYSQL_DATABASE=wavssv3_db
MYSQL_ROOT_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# ==========================================
# AI Triage Configuration (Optional)
# ==========================================
# Add your Gemini API key below to enable the AI 
# triage feature at the end of every scan.
AI_API_KEY=""
